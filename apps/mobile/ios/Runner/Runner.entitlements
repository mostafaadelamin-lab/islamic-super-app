<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CarPlay audio app (approved by Apple 2026-11-17). The App ID org.rattil.app must have
	     the CarPlay Audio capability, or signing fails. -->
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<!-- The prayer widget reads the prayer times the app writes here. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.rattil.app</string>
	</array>
</dict>
</plist>
