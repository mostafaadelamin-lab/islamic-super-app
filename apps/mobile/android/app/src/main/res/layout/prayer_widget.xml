<?xml version="1.0" encoding="utf-8"?>
<!-- Small home-screen widget (owner 2026-11-22: no circle): the next prayer's name, its time and the
     countdown, three centred lines on the user's colour style. PrayerWidgetProvider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_madinah"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_prayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#E6FFFFFF"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Chronometer
        android:id="@+id/widget_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#D9B25E"
        android:textSize="18sp" />
</LinearLayout>
