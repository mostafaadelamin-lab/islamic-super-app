{
  "name": "@rattil/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/prepare-content.mjs",
    "dev": "npm run content && next dev",
    "build": "npm run content && next build && node scripts/generate-sw.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "npm run content && vitest run",
    "test:coverage": "npm run content && vitest run --coverage",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run content && tsc --noEmit"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "adhan": "4.4.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "31.0.0",
    "lighthouse": "13.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
