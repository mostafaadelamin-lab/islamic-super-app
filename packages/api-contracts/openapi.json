   "get": {
    "operationId": "prayer_times_v1_prayer_times_get",
    "parameters": [
     {
      "in": "query",
      "name": "lat",
      "required": true,
      "schema": {
       "exclusiveMaximum": 90,
       "exclusiveMinimum": -90,
       "title": "Lat",
       "type": "number"
      }
     },
     {
      "in": "query",
      "name": "lng",
      "required": true,
      "schema": {
       "maximum": 180,
       "minimum": -180,
       "title": "Lng",
       "type": "number"
      }
     },
     {
      "in": "query",
      "name": "date",
      "required": true,
      "schema": {
       "format": "date",
       "title": "Date",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "tz",
      "required": true,
      "schema": {
       "maxLength": 64,
       "minLength": 1,
       "title": "Tz",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "method",
      "required": false,
      "schema": {
       "default": "mwl",
       "title": "Method",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "asr",
      "required": false,
      "schema": {
       "default": "standard",
       "pattern": "^(standard|hanafi)$",
       "title": "Asr",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {}
       }
      },
      "description": "Successful Response"
